#!/usr/bin/env python3
"""AWS Events MCP token refresh helper — silent refresh using stored refresh token.

Reads refresh token from SSM, calls token endpoint, stores new tokens.
Called by the bridge launcher when access token is expired.

Returns the new access token on stdout (for use by bridge scripts).
Returns non-zero exit code on failure (caller should re-auth).

SSM paths:
  /heraldstack/shared/awsevents/access-token
  /heraldstack/shared/awsevents/refresh-token
  /heraldstack/shared/awsevents/token-expires-at
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import time
import urllib.parse
import urllib.request

TOKEN_URL = "https://oauth.awsevents.com/oauth2/token"
CLIENT_ID = "7vmom55m1qstvq8i71ph127bfq"

SSM_PREFIX = "/heraldstack/shared/awsevents"
SSM_PROFILE = os.environ.get("AWS_PROFILE", "ops-reader")
SSM_REGION = os.environ.get("AWS_REGION", "us-west-2")


def ssm_put(name: str, value: str, description: str = "") -> None:
    """Store a parameter in SSM Parameter Store (SecureString)."""
    full_name = f"{SSM_PREFIX}/{name}"
    cmd = [
        "aws", "ssm", "put-parameter",
        "--name", full_name,
        "--value", value,
        "--type", "SecureString",
        "--overwrite",
        "--profile", SSM_PROFILE,
        "--region", SSM_REGION,
    ]
    if description:
        cmd.extend(["--description", description])
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(f"ssm put-parameter failed: {result.stderr}")


def ssm_get(name: str) -> str | None:
    """Get a parameter from SSM Parameter Store."""
    full_name = f"{SSM_PREFIX}/{name}"
    cmd = [
        "aws", "ssm", "get-parameter",
        "--name", full_name,
        "--with-decryption",
        "--profile", SSM_PROFILE,
        "--region", SSM_REGION,
    ]
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        return None
    data = json.loads(result.stdout)
    return data["Parameter"]["Value"]


def _http_post_form(url: str, fields: dict) -> dict:
    data = urllib.parse.urlencode(fields).encode()
    req = urllib.request.Request(url, data=data, headers={
        "Content-Type": "application/x-www-form-urlencoded",
        "Accept": "application/json",
    })
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.loads(resp.read().decode() or "{}")


def refresh_tokens(refresh_token: str) -> dict:
    return _http_post_form(TOKEN_URL, {
        "grant_type": "refresh_token",
        "client_id": CLIENT_ID,
        "refresh_token": refresh_token,
    })


def store_tokens(resp: dict) -> str:
    """Store tokens to SSM Parameter Store; return access token."""
    access_token = resp.get("access_token", "")
    refresh_token = resp.get("refresh_token", "")
    expires_in = int(resp.get("expires_in", 3600))
    expires_at = int(time.time() + expires_in)

    if not access_token:
        raise ValueError("no access_token in response")

    ssm_put("access-token", access_token, "AWS Events MCP access token (60 min TTL)")
    if refresh_token:
        # refresh token rotates on each refresh
        ssm_put("refresh-token", refresh_token, "AWS Events MCP refresh token (30 day TTL, rotates)")
    ssm_put("token-expires-at", str(expires_at), "AWS Events MCP access token expiry (unix timestamp)")

    return access_token


def get_valid_access_token() -> str | None:
    """Return valid access token, refreshing if needed.

    Returns None if refresh fails or never signed in.
    """
    expires_at_str = ssm_get("token-expires-at")
    if not expires_at_str:
        return None

    expires_at = int(expires_at_str)
    skew = 60  # refresh 60 seconds before expiry

    if time.time() + skew < expires_at:
        # access token still valid
        return ssm_get("access-token")

    # access token expired, try refresh
    refresh_token = ssm_get("refresh-token")
    if not refresh_token:
        return None

    try:
        resp = refresh_tokens(refresh_token)
        return store_tokens(resp)
    except Exception:
        # refresh failed (expired, revoked, etc.)
        return None


def main() -> int:
    """Print access token on stdout, or exit 1 if refresh fails."""
    try:
        token = get_valid_access_token()
        if token:
            print(token)
            return 0
        else:
            print("error: no valid token; run awsevents-mcp-login", file=sys.stderr)
            return 1
    except Exception as e:
        print(f"error: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
